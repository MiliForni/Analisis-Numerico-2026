@{
    ViewBag.Title = "Análisis Numérico";
}

<style>
    body {
        background-color: #FFFFFF;
    }

    .pagina-principal {
        max-width: 1100px;
        margin: 0 auto;
        padding: 55px 25px 70px;
        font-family: Arial, sans-serif;
    }

    .encabezado-principal {
        text-align: center;
        margin-bottom: 45px;
    }

        .encabezado-principal h1 {
            margin: 0;
            color: #555555;
            font-size: 38px;
            font-weight: bold;
        }

        .encabezado-principal p {
            margin-top: 12px;
            margin-bottom: 12px;
            color: #777777;
            font-size: 18px;
        }

    .linea-titulo {
        width: 60px;
        height: 3px;
        margin: 16px auto 0;
        border-radius: 3px;
        background-color: #E889AE;
    }

    .contenedor-unidades {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 28px;
    }

    .tarjeta-unidad {
        min-height: 220px;
        padding: 30px;
        border: 2px solid #E8A0BC;
        border-radius: 6px;
        background-color: #FFFFFF;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        box-sizing: border-box;
        position: relative;
    }

        .tarjeta-unidad:hover {
            transform: translateY(-4px);
            border-color: #E889AE;
            box-shadow: 0 7px 18px rgba(232, 137, 174, 0.22);
            text-decoration: none;
        }

    .tarjeta-activa {
        cursor: pointer;
        pointer-events: auto;
        z-index: 2;
    }

    .tarjeta-inactiva {
        cursor: default;
    }

    .formula-unidad {
        margin-bottom: 15px;
        color: #555555;
        font-size: 31px;
        font-weight: bold;
    }

    .separador-unidad {
        width: 95px;
        height: 2px;
        margin-bottom: 18px;
        background-color: #E889AE;
    }

    .tarjeta-unidad h2 {
        margin: 0 0 9px;
        color: #555555;
        font-size: 25px;
        font-weight: bold;
    }

    .tarjeta-unidad p {
        margin: 0;
        color: #777777;
        font-size: 16px;
    }

    .tarjeta-activa:hover .formula-unidad,
    .tarjeta-activa:hover h2 {
        color: #E889AE;
    }

    @@media (max-width: 800px) {

        .pagina-principal {
            padding: 35px 18px 50px;
        }

        .contenedor-unidades {
            grid-template-columns: 1fr;
        }

        .encabezado-principal h1 {
            font-size: 32px;
        }

        .tarjeta-unidad {
            min-height: 190px;
        }
    }
</style>

<main class="pagina-principal">

    <!-- Encabezado -->
    <header class="encabezado-principal">

        <h1>
            Análisis Numérico
        </h1>

        <p>
            Menú principal
        </p>

        <div class="linea-titulo"></div>

    </header>

    <!-- Unidades -->
    <section class="contenedor-unidades">

        <!-- Unidad 1 -->
        @Html.ActionLink(
            " ",
            "Index",
            "Unidad1",
            null,
            new
            {
                @class = "tarjeta-unidad tarjeta-activa",
                id = "linkUnidad1"
            }
        )

        <script>
            document.addEventListener("DOMContentLoaded", function () {

                var tarjetaUnidad1 =
                    document.getElementById("linkUnidad1");

                if (tarjetaUnidad1) {

                    tarjetaUnidad1.innerHTML = `
                                <div class="formula-unidad">
                                    f(x)
                                </div>

                                <div class="separador-unidad"></div>

                                <h2>
                                    Unidad 1
                                </h2>

                                <p>
                                    Raíces de funciones
                                </p>
                            `;
                }
            });
        </script>

        <!-- Unidad 2 -->
        <div class="tarjeta-unidad tarjeta-inactiva">

            <div class="formula-unidad">
                Ax = b
            </div>

            <div class="separador-unidad"></div>

            <h2>
                Unidad 2
            </h2>

            <p>
                Sistemas de ecuaciones
            </p>

        </div>

        <!-- Unidad 3 -->
        <div class="tarjeta-unidad tarjeta-inactiva">

            <div class="formula-unidad">
                x, y
            </div>

            <div class="separador-unidad"></div>

            <h2>
                Unidad 3
            </h2>

            <p>
                Ajuste de curvas
            </p>

        </div>

        <!-- Unidad 4 -->
        <div class="tarjeta-unidad tarjeta-inactiva">

            <div class="formula-unidad">
                ∫ f(x)
            </div>

            <div class="separador-unidad"></div>

            <h2>
                Unidad 4
            </h2>

            <p>
                Integración numérica
            </p>

        </div>

    </section>

</main>