@{
    ViewBag.Title = "Análisis Numérico";
}

<style>
    body {
        background-color: #2B2C33;
    }

    .inicio-analisis {
        max-width: 1000px;
        margin: 55px auto;
        text-align: center;
        font-family: Arial, sans-serif;
    }

        .inicio-analisis h1 {
            margin-bottom: 8px;
            font-size: 36px;
            font-weight: 600;
            color: #B2D5E5;
            letter-spacing: 0.5px;
        }

    .subtitulo {
        position: relative;
        display: inline-block;
        margin-bottom: 42px;
        padding-bottom: 12px;
        color: #B2D5E5;
        font-size: 17px;
    }

        .subtitulo::after {
            content: "";
            position: absolute;
            width: 55px;
            height: 3px;
            left: 50%;
            bottom: 0;
            transform: translateX(-50%);
            background-color: #B2D5E5;
            border-radius: 10px;
        }

    .contenedor-unidades {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 28px;
    }

    .tarjeta-unidad {
        min-height: 225px;
        padding: 30px 25px;
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 16px;
        background-color: #B2D5E5;
        color: #020202;
        text-decoration: none;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.22);
        transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }

        .tarjeta-unidad:hover {
            transform: translateY(-6px);
            background-color: #c2deeb;
            color: #020202;
            text-decoration: none;
            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.30);
        }

    .unidad-icono {
        display: flex;
        width: 95px;
        height: 70px;
        margin: 0 auto 22px;
        align-items: center;
        justify-content: center;
        border-bottom: 2px solid #3A3B42;
        color: #3A3B42;
        font-size: 29px;
        font-weight: 700;
    }

    .tarjeta-unidad h2 {
        margin-bottom: 8px;
        color: #020202;
        font-size: 23px;
        font-weight: 600;
    }

    .nombre-unidad {
        margin-bottom: 0;
        color: #222;
        font-size: 16px;
    }

    @@media (max-width: 768px) {
        .contenedor-unidades {
            grid-template-columns: 1fr;
        }

        .inicio-analisis {
            margin: 35px 20px;
        }
    }
</style>

<main class="inicio-analisis">

    <h1>Análisis Numérico</h1>
    <p class="subtitulo">Menú principal</p>

    <div class="contenedor-unidades">

        <a href="@Url.Action("Index", "Unidad1")"
           class="tarjeta-unidad">

            <div class="unidad-icono">f(x)</div>

            <h2>Unidad 1</h2>

            <p class="nombre-unidad">
                Raíces de funciones
            </p>

        </a>


        <a href="#" class="tarjeta-unidad">

            <div class="unidad-icono">Ax = b</div>

            <h2>Unidad 2</h2>

            <p class="nombre-unidad">
                Sistemas de ecuaciones
            </p>

        </a>


        <a href="#" class="tarjeta-unidad">

            <div class="unidad-icono">x, y</div>

            <h2>Unidad 3</h2>

            <p class="nombre-unidad">
                Ajuste de curvas
            </p>

        </a>


        <a href="#" class="tarjeta-unidad">

            <div class="unidad-icono">&int; f(x)</div>

            <h2>Unidad 4</h2>

            <p class="nombre-unidad">
                Integración numérica
            </p>

        </a>

    </div>

</main>