@{
    ViewBag.Title = "Unidad 1 - Raíces de funciones";
}

<style>
    .pagina-unidad {
        max-width: 1250px;
        margin: 25px auto;
        font-family: Arial, sans-serif;
    }

    .encabezado-unidad {
        margin-bottom: 25px;
        text-align: center;
    }

        .encabezado-unidad h1 {
            margin-bottom: 5px;
            color: #253238;
            font-size: 34px;
        }

        .encabezado-unidad p {
            color: #666;
            font-size: 17px;
        }

    .volver {
        display: inline-block;
        margin-bottom: 15px;
        color: #2c5f7c;
        font-size: 16px;
        text-decoration: none;
    }

        .volver:hover {
            text-decoration: underline;
        }

    .contenedor-paneles {
        display: grid;
        grid-template-columns: 280px 1fr 280px;
        gap: 20px;
        align-items: stretch;
    }

    .panel {
        padding: 22px;
        border: 1px solid #b5b5b5;
        border-radius: 10px;
        background-color: white;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.12);
    }

        .panel h2 {
            margin-top: 0;
            margin-bottom: 22px;
            color: #253238;
            font-size: 23px;
            text-align: center;
        }

    .grupo-campo {
        margin-bottom: 15px;
    }

        .grupo-campo label {
            display: block;
            margin-bottom: 6px;
            color: #444;
            font-weight: 600;
        }

        .grupo-campo input,
        .grupo-campo select {
            width: 100%;
            padding: 9px;
            border: 1px solid #aaa;
            border-radius: 5px;
            box-sizing: border-box;
        }

    .intervalo {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .boton-calcular {
        width: 100%;
        margin-top: 10px;
        padding: 11px;
        border: none;
        border-radius: 6px;
        background-color: #2c5f7c;
        color: white;
        font-size: 17px;
        cursor: pointer;
    }

        .boton-calcular:hover {
            background-color: #21485e;
        }

    .panel-grafico {
        min-height: 530px;
    }

    .grafico-vacio {
        display: flex;
        height: 440px;
        padding: 20px;
        align-items: center;
        justify-content: center;
        border: 1px solid #bbb;
        border-radius: 6px;
        background-image: linear-gradient(#eeeeee 1px, transparent 1px), linear-gradient(90deg, #eeeeee 1px, transparent 1px);
        background-size: 25px 25px;
        color: #777;
        text-align: center;
    }

    .fila-resultado {
        margin-bottom: 15px;
    }

        .fila-resultado label {
            display: block;
            margin-bottom: 5px;
            color: #555;
            font-weight: 600;
        }

    .valor-resultado {
        min-height: 38px;
        padding: 9px;
        border: 1px solid #bbb;
        border-radius: 5px;
        background-color: #f4f4f4;
        box-sizing: border-box;
    }

    @@media (max-width: 1000px) {
        .contenedor-paneles {
            grid-template-columns: 1fr;
        }

        .panel-grafico {
            min-height: auto;
        }
    }
</style>

<main class="pagina-unidad">

    <a href="@Url.Action("Index", "Home")"
       class="volver">
        ← Volver al menú principal
    </a>

    <header class="encabezado-unidad">

        <h1>Análisis Numérico</h1>

        <p>
            Unidad 1 - Raíces de funciones
        </p>

    </header>

    <div class="contenedor-paneles">

        <section class="panel">

            <h2>Ingreso de datos</h2>

            <div class="grupo-campo">

                <label for="funcion">
                    Función
                </label>

                <input type="text"
                       id="funcion"
                       name="funcion"
                       placeholder="Ejemplo: x^2 - 2" />

            </div>

            <div class="grupo-campo">

                <label for="metodo">
                    Método
                </label>

                <select id="metodo" name="metodo">

                    <option value="">
                        Seleccione un método
                    </option>

                    <option value="Biseccion">
                        Bisección
                    </option>

                    <option value="ReglaFalsa">
                        Regla falsa
                    </option>

                </select>

            </div>

            <div class="grupo-campo">

                <label for="iteraciones">
                    Iteraciones
                </label>

                <input type="number"
                       id="iteraciones"
                       name="iteraciones"
                       min="1"
                       placeholder="Ejemplo: 100" />

            </div>

            <div class="grupo-campo">

                <label for="tolerancia">
                    Tolerancia
                </label>

                <input type="text"
                       id="tolerancia"
                       name="tolerancia"
                       placeholder="Ejemplo: 0.0001" />

            </div>

            <div class="grupo-campo">

                <label>Intervalo</label>

                <div class="intervalo">

                    <div>

                        <label for="xi">
                            Xi
                        </label>

                        <input type="text"
                               id="xi"
                               name="xi"
                               placeholder="1" />

                    </div>

                    <div>

                        <label for="xd">
                            Xd
                        </label>

                        <input type="text"
                               id="xd"
                               name="xd"
                               placeholder="2" />

                    </div>

                </div>

            </div>

            <button type="button"
                    class="boton-calcular">
                Calcular
            </button>

        </section>

        <section class="panel panel-grafico">

            <h2>Gráfico</h2>

            <div class="grafico-vacio">
                Aquí se mostrará el gráfico de la función utilizando GeoGebra.
            </div>

        </section>

        <section class="panel">

            <h2>Resultados</h2>

            <div class="fila-resultado">

                <label>Función utilizada</label>

                <div class="valor-resultado">
                    —
                </div>

            </div>

            <div class="fila-resultado">

                <label>Método utilizado</label>

                <div class="valor-resultado">
                    —
                </div>

            </div>

            <div class="fila-resultado">

                <label>Iteraciones realizadas</label>

                <div class="valor-resultado">
                    —
                </div>

            </div>

            <div class="fila-resultado">

                <label>Tolerancia utilizada</label>

                <div class="valor-resultado">
                    —
                </div>

            </div>

            <div class="fila-resultado">

                <label>Intervalo utilizado</label>

                <div class="valor-resultado">
                    —
                </div>

            </div>

            <div class="fila-resultado">

                <label>¿Converge?</label>

                <div class="valor-resultado">
                    —
                </div>

            </div>

            <div class="fila-resultado">

                <label>Raíz</label>

                <div class="valor-resultado">
                    —
                </div>

            </div>

            <div class="fila-resultado">

                <label>Error</label>

                <div class="valor-resultado">
                    —
                </div>

            </div>

        </section>

    </div>

</main>