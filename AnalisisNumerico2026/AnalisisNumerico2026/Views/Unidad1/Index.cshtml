@model AnalisisNumerico2026.Models.Unidad1ViewModel

@{
    ViewBag.Title = "Unidad 1 - Raíces de funciones";
}

<style>
    .pagina-unidad {
        max-width: 1250px;
        margin: 25px auto;
        font-family: Arial, sans-serif;
    }

    .encabezado-unidad {
        margin-bottom: 25px;
        text-align: center;
    }

        .encabezado-unidad h1 {
            margin-bottom: 5px;
            color: #253238;
            font-size: 34px;
        }

        .encabezado-unidad p {
            color: #666;
            font-size: 17px;
        }

    .volver {
        display: inline-block;
        margin-bottom: 15px;
        color: #2c5f7c;
        font-size: 16px;
        text-decoration: none;
    }

        .volver:hover {
            text-decoration: underline;
        }

    .contenedor-paneles {
        display: grid;
        grid-template-columns: 280px 1fr 280px;
        gap: 20px;
        align-items: stretch;
    }

    .panel {
        padding: 22px;
        border: 1px solid #b5b5b5;
        border-radius: 10px;
        background-color: white;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.12);
    }

        .panel h2 {
            margin-top: 0;
            margin-bottom: 22px;
            color: #253238;
            font-size: 23px;
            text-align: center;
        }

    .grupo-campo {
        margin-bottom: 15px;
    }

        .grupo-campo label {
            display: block;
            margin-bottom: 6px;
            color: #444;
            font-weight: 600;
        }

    .campo {
        width: 100%;
        padding: 9px;
        border: 1px solid #aaa;
        border-radius: 5px;
        box-sizing: border-box;
    }

    .intervalo {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .boton-calcular {
        width: 100%;
        margin-top: 10px;
        padding: 11px;
        border: none;
        border-radius: 6px;
        background-color: #2c5f7c;
        color: white;
        font-size: 17px;
        cursor: pointer;
    }

        .boton-calcular:hover {
            background-color: #21485e;
        }

    .panel-grafico {
        min-height: 530px;
    }

    .grafico-vacio {
        display: flex;
        height: 440px;
        padding: 20px;
        align-items: center;
        justify-content: center;
        border: 1px solid #bbb;
        border-radius: 6px;
        background-image: linear-gradient(#eeeeee 1px, transparent 1px), linear-gradient(90deg, #eeeeee 1px, transparent 1px);
        background-size: 25px 25px;
        color: #777;
        text-align: center;
        box-sizing: border-box;
    }

    .fila-resultado {
        margin-bottom: 15px;
    }

        .fila-resultado label {
            display: block;
            margin-bottom: 5px;
            color: #555;
            font-weight: 600;
        }

    .valor-resultado {
        min-height: 38px;
        padding: 9px;
        border: 1px solid #bbb;
        border-radius: 5px;
        background-color: #f4f4f4;
        box-sizing: border-box;
        word-break: break-word;
    }

    .mensaje-error {
        margin-bottom: 20px;
        padding: 12px;
        border: 1px solid #dc3545;
        border-radius: 6px;
        background-color: #f8d7da;
        color: #842029;
    }

    .text-danger {
        display: block;
        margin-top: 4px;
        color: #dc3545;
        font-size: 13px;
    }

    @@media (max-width: 1000px) {
        .contenedor-paneles {
            grid-template-columns: 1fr;
        }

        .panel-grafico {
            min-height: auto;
        }
    }
</style>

<main class="pagina-unidad">

    <a href="@Url.Action("Index", "Home")"
       class="volver">
        ← Volver al menú principal
    </a>

    <header class="encabezado-unidad">
        <h1>Análisis Numérico</h1>
        <p>Unidad 1 - Raíces de funciones</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
    {
        <div class="mensaje-error">
            @Model.MensajeError
        </div>
    }

    <div class="contenedor-paneles">

        <!-- INGRESO DE DATOS -->
        <section class="panel">

            <h2>Ingreso de datos</h2>

            @using (Html.BeginForm(
                "Index",
                "Unidad1",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="grupo-campo">

                    @Html.LabelFor(m => m.Funcion)

                    @Html.TextBoxFor(
                        m => m.Funcion,
                        new
                        {
                            @class = "campo",
                            placeholder = "Ejemplo: x^2 - 2"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Funcion,
                        "",
                        new { @class = "text-danger" })

                </div>

                <div class="grupo-campo">

                    @Html.LabelFor(m => m.Metodo)

                    @Html.DropDownListFor(
                        m => m.Metodo,
                        new List<SelectListItem>
                        {
                            new SelectListItem
                            {
                                Text = "Seleccione un método",
                                Value = ""
                            },
                            new SelectListItem
                            {
                                Text = "Bisección",
                                Value = "Biseccion"
                            },
                            new SelectListItem
                            {
                                Text = "Regla falsa",
                                Value = "ReglaFalsa"
                            }
                        },
                        new { @class = "campo" })

                    @Html.ValidationMessageFor(
                        m => m.Metodo,
                        "",
                        new { @class = "text-danger" })

                </div>

                <div class="grupo-campo">

                    @Html.LabelFor(m => m.Iteraciones)

                    @Html.TextBoxFor(
                        m => m.Iteraciones,
                        new
                        {
                            @class = "campo",
                            type = "number",
                            min = "1",
                            placeholder = "Ejemplo: 100"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Iteraciones,
                        "",
                        new { @class = "text-danger" })

                </div>

                <div class="grupo-campo">

                    @Html.LabelFor(m => m.Tolerancia)

                    @Html.TextBoxFor(
                        m => m.Tolerancia,
                        new
                        {
                            @class = "campo",
                            placeholder = "Ejemplo: 0.0001"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Tolerancia,
                        "",
                        new { @class = "text-danger" })

                </div>

                <div class="grupo-campo">

                    <label>Intervalo</label>

                    <div class="intervalo">

                        <div>

                            @Html.LabelFor(m => m.Xi)

                            @Html.TextBoxFor(
                                m => m.Xi,
                                new
                                {
                                    @class = "campo",
                                    placeholder = "1"
                                })

                            @Html.ValidationMessageFor(
                                m => m.Xi,
                                "",
                                new { @class = "text-danger" })

                        </div>

                        <div>

                            @Html.LabelFor(m => m.Xd)

                            @Html.TextBoxFor(
                                m => m.Xd,
                                new
                                {
                                    @class = "campo",
                                    placeholder = "2"
                                })

                            @Html.ValidationMessageFor(
                                m => m.Xd,
                                "",
                                new { @class = "text-danger" })

                        </div>

                    </div>

                </div>

                <button type="submit"
                        class="boton-calcular">
                    Calcular
                </button>
            }

        </section>


        <!-- GRÁFICO -->
        <section class="panel panel-grafico">

            <h2>Gráfico</h2>

            <div id="ggb-element"></div>

        </section>


        <!-- RESULTADOS -->
        <section class="panel">

            <h2>Resultados</h2>

            <div class="fila-resultado">
                <label>Función utilizada</label>

                <div class="valor-resultado">
                    @if (!string.IsNullOrWhiteSpace(Model.Funcion))
                    {
                        @Model.Funcion
                    }
                    else
                    {
                        <text>—</text>
                    }
                </div>
            </div>


            <div class="fila-resultado">
                <label>Método utilizado</label>

                <div class="valor-resultado">

                    @if (Model.Metodo == "Biseccion")
                    {
                        <text>Bisección</text>
                    }
                    else if (Model.Metodo == "ReglaFalsa")
                    {
                        <text>Regla falsa</text>
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>
            </div>


            <div class="fila-resultado">
                <label>Iteraciones realizadas</label>

                <div class="valor-resultado">

                    @if (Model.IteracionesRealizadas.HasValue)
                    {
                        @Model.IteracionesRealizadas.Value
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>
            </div>


            <div class="fila-resultado">
                <label>Tolerancia utilizada</label>

                <div class="valor-resultado">

                    @if (Model.Tolerancia.HasValue)
                    {
                        @Model.Tolerancia.Value
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>
            </div>


            <div class="fila-resultado">
                <label>Intervalo utilizado</label>

                <div class="valor-resultado">

                    @if (Model.Xi.HasValue && Model.Xd.HasValue)
                    {
                        <text>
                            [@Model.Xi.Value, @Model.Xd.Value]
                        </text>
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>
            </div>


            <div class="fila-resultado">
                <label>¿Converge?</label>

                <div class="valor-resultado">

                    @if (Model.Converge.HasValue)
                    {
                        if (Model.Converge.Value)
                        {
                            <text>Sí</text>
                        }
                        else
                        {
                            <text>No</text>
                        }
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>
            </div>


            <div class="fila-resultado">
                <label>Raíz</label>

                <div class="valor-resultado">

                    @if (Model.Raiz.HasValue)
                    {
                        @Model.Raiz.Value
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>
            </div>


            <div class="fila-resultado">
                <label>Error</label>

                <div class="valor-resultado">

                    @if (Model.Error.HasValue)
                    {
                        @Model.Error.Value
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>
            </div>

        </section>

    </div>

</main>
<script src="https://www.geogebra.org/apps/deployggb.js"></script>

<script>
    var parametros = {
        "appName": "graphing",
        "width": 600,
        "height": 440,
        "showToolBar": false,
        "showAlgebraInput": false,
        "showMenuBar": false,
        "appletOnLoad": function (api) {

            var funcion = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Funcion ?? ""))';

var funcionValida =
    @((ViewBag.FuncionValida ?? false).ToString().ToLower());

if (funcionValida && funcion !== "") {
    api.evalCommand("f(x)=" + funcion);
}
        }
    };

    var applet = new GGBApplet(parametros, true);

    window.addEventListener("load", function () {
        applet.inject("ggb-element");
    });
</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}