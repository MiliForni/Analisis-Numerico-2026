@model AnalisisNumerico2026.Models.Unidad1ViewModel

@{
    ViewBag.Title = "Unidad 1 - Raíces de funciones";
}

<style>
    body {
        background-color: #2B2C33;
    }

    .pagina-unidad {
        max-width: 1350px;
        margin: 30px auto;
        padding: 0 20px;
        font-family: Arial, sans-serif;
    }

    .volver {
        display: inline-block;
        margin-bottom: 18px;
        color: #B2D5E5;
        text-decoration: none;
        font-size: 15px;
    }

        .volver:hover {
            color: white;
            text-decoration: none;
        }

    .encabezado-unidad {
        margin-bottom: 30px;
        text-align: center;
    }

        .encabezado-unidad h1 {
            margin-bottom: 7px;
            color: #B2D5E5;
            font-size: 36px;
        }

        .encabezado-unidad p {
            color: #B2D5E5;
            font-size: 17px;
        }

    .contenedor-paneles {
        display: grid;
        grid-template-columns: 310px 1fr 300px;
        gap: 22px;
        align-items: stretch;
    }

    .panel {
        padding: 25px;
        border-radius: 14px;
        background-color: #B2D5E5;
        box-shadow: 0 7px 18px rgba(0, 0, 0, 0.25);
    }

        .panel h2 {
            margin-top: 0;
            margin-bottom: 25px;
            color: #020202;
            text-align: center;
            font-size: 23px;
        }

    .grupo-campo {
        margin-bottom: 16px;
    }

        .grupo-campo label {
            display: block;
            margin-bottom: 6px;
            color: #020202;
            font-weight: bold;
        }

    .campo {
        width: 100%;
        padding: 10px;
        border: 1px solid #777;
        border-radius: 6px;
        background-color: white;
        color: #020202;
        box-sizing: border-box;
    }

    .dos-columnas {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .subtitulo-campo {
        margin-top: 20px;
        margin-bottom: 12px;
        color: #2B2C33;
        font-size: 15px;
        font-weight: bold;
    }

    .boton-calcular {
        width: 100%;
        margin-top: 8px;
        padding: 12px;
        border: none;
        border-radius: 7px;
        background-color: #2B2C33;
        color: white;
        font-size: 16px;
        cursor: pointer;
    }

        .boton-calcular:hover {
            background-color: #020202;
        }

    .mensaje-error {
        margin-bottom: 20px;
        padding: 13px;
        border: 1px solid #b02a37;
        border-radius: 7px;
        background-color: #f8d7da;
        color: #842029;
    }

    .text-danger {
        display: block;
        margin-top: 4px;
        color: #b02a37;
        font-size: 13px;
    }

    .panel-grafico {
        min-height: 620px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        overflow: hidden;
        padding: 25px;
    }

    .contenedor-geogebra {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

    #ggb-element {
        width: 590px;
        height: 520px;
        margin: 0 auto;
        overflow: hidden;
        border-radius: 8px;
        background-color: white;
    }

        #ggb-element > div {
            margin: 0 auto !important;
        }

    .fila-resultado {
        margin-bottom: 14px;
    }

        .fila-resultado label {
            display: block;
            margin-bottom: 5px;
            color: #020202;
            font-weight: bold;
        }

    .valor-resultado {
        min-height: 39px;
        padding: 10px;
        border: 1px solid #999;
        border-radius: 6px;
        background-color: white;
        color: #020202;
        word-break: break-word;
    }

    @@media (max-width: 1050px) {
        .contenedor-paneles {
            grid-template-columns: 1fr;
        }

        #ggb-element {
            width: 100%;
            max-width: 590px;
        }
    }
</style>

<main class="pagina-unidad">

    <a href="@Url.Action("Index", "Home")"
       class="volver">
        ← Volver al menú principal
    </a>

    <header class="encabezado-unidad">
        <h1>Análisis Numérico</h1>
        <p>Unidad 1 - Raíces de funciones</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
    {
        <div class="mensaje-error">
            @Model.MensajeError
        </div>
    }

    <div class="contenedor-paneles">

        <!-- Ingreso de datos -->
        <section class="panel">

            <h2>Ingreso de datos</h2>

            @using (Html.BeginForm("Index", "Unidad1", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                // Función
                <div class="grupo-campo">

                    @Html.LabelFor(m => m.Funcion)

                    @Html.TextBoxFor(
                        m => m.Funcion,
                        new
                        {
                            @class = "campo",
                            placeholder = "Ejemplo: x^2 - 2"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Funcion,
                        "",
                        new { @class = "text-danger" })

                </div>

                // Método
                <div class="grupo-campo">

                    @Html.LabelFor(m => m.Metodo)

                    @Html.DropDownListFor(
                        m => m.Metodo,
                        new List<SelectListItem>
                        {
                            new SelectListItem
                            {
                                Text = "Seleccione un método",
                                Value = ""
                            },

                            new SelectListItem
                            {
                                Text = "Bisección",
                                Value = "Biseccion"
                            },

                            new SelectListItem
                            {
                                Text = "Regla falsa",
                                Value = "ReglaFalsa"
                            },

                            new SelectListItem
                            {
                                Text = "Newton-Raphson",
                                Value = "Newton"
                            },

                            new SelectListItem
                            {
                                Text = "Secante",
                                Value = "Secante"
                            }
                        },
                        new
                        {
                            @class = "campo",
                            id = "Metodo"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Metodo,
                        "",
                        new { @class = "text-danger" })

                </div>

                // Iteraciones
                <div class="grupo-campo">

                    @Html.LabelFor(m => m.Iteraciones)

                    @Html.TextBoxFor(
                        m => m.Iteraciones,
                        new
                        {
                            @class = "campo",
                            type = "number",
                            min = "1",
                            placeholder = "Ejemplo: 100"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Iteraciones,
                        "",
                        new { @class = "text-danger" })

                </div>

                // Tolerancia
                <div class="grupo-campo">

                    @Html.LabelFor(m => m.Tolerancia)

                    @Html.TextBoxFor(
                        m => m.Tolerancia,
                        new
                        {
                            @class = "campo",
                            placeholder = "Ejemplo: 0.0001"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Tolerancia,
                        "",
                        new { @class = "text-danger" })

                </div>

                // Métodos cerrados
                <div id="camposCerrados">

                    <div class="subtitulo-campo">
                        Intervalo
                    </div>

                    <div class="dos-columnas">

                        <div class="grupo-campo">

                            @Html.LabelFor(m => m.Xi)

                            @Html.TextBoxFor(
                                m => m.Xi,
                                new
                                {
                                    @class = "campo",
                                    placeholder = "Xi"
                                })

                        </div>

                        <div class="grupo-campo">

                            @Html.LabelFor(m => m.Xd)

                            @Html.TextBoxFor(
                                m => m.Xd,
                                new
                                {
                                    @class = "campo",
                                    placeholder = "Xd"
                                })

                        </div>

                    </div>

                </div>

                // Newton
                <div id="camposNewton"
                     style="display:none;">

                    <div class="subtitulo-campo">
                        Valor inicial
                    </div>

                    <div class="grupo-campo">

                        @Html.LabelFor(m => m.X0)

                        @Html.TextBoxFor(
                            m => m.X0,
                            new
                            {
                                @class = "campo",
                                placeholder = "X0"
                            })

                    </div>

                </div>

                // Secante
                <div id="camposSecante"
                     style="display:none;">

                    <div class="subtitulo-campo">
                        Valores iniciales
                    </div>

                    <div class="dos-columnas">

                        <div class="grupo-campo">

                            @Html.LabelFor(m => m.X0)

                            @Html.TextBoxFor(
                                m => m.X0,
                                new
                                {
                                    @class = "campo",
                                    placeholder = "X0"
                                })

                        </div>

                        <div class="grupo-campo">

                            @Html.LabelFor(m => m.X1)

                            @Html.TextBoxFor(
                                m => m.X1,
                                new
                                {
                                    @class = "campo",
                                    placeholder = "X1"
                                })

                        </div>

                    </div>

                </div>

                // Escala del gráfico
                <div class="subtitulo-campo">
                    Escala del gráfico
                </div>

                <div class="dos-columnas">

                    <div class="grupo-campo">

                        @Html.LabelFor(m => m.XMin)

                        @Html.TextBoxFor(
                            m => m.XMin,
                            new
                            {
                                @class = "campo",
                                placeholder = "-5"
                            })

                    </div>

                    <div class="grupo-campo">

                        @Html.LabelFor(m => m.XMax)

                        @Html.TextBoxFor(
                            m => m.XMax,
                            new
                            {
                                @class = "campo",
                                placeholder = "5"
                            })

                    </div>

                </div>

                <button type="submit"
                        class="boton-calcular">
                    Calcular
                </button>
            }

        </section>

        <!-- Gráfico -->
        <section class="panel panel-grafico">

            <h2>Gráfico</h2>

            <div class="contenedor-geogebra">
                <div id="ggb-element"></div>
            </div>

        </section>

        <!-- Resultados -->
        <section class="panel">

            <h2>Resultados</h2>

            <div class="fila-resultado">
                <label>Función utilizada</label>

                <div class="valor-resultado">
                    @if (!string.IsNullOrWhiteSpace(Model.Funcion))
                    {
                        @Model.Funcion
                    }
                    else
                    {
                        <text>—</text>
                    }
                </div>
            </div>

            <div class="fila-resultado">
                <label>Método utilizado</label>

                <div class="valor-resultado">

                    @if (Model.Metodo == "Biseccion")
                    {
                        <text>Bisección</text>
                    }
                    else if (Model.Metodo == "ReglaFalsa")
                    {
                        <text>Regla falsa</text>
                    }
                    else if (Model.Metodo == "Newton")
                    {
                        <text>Newton-Raphson</text>
                    }
                    else if (Model.Metodo == "Secante")
                    {
                        <text>Secante</text>
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>
            </div>

            <div class="fila-resultado">
                <label>Iteraciones realizadas</label>

                <div class="valor-resultado">

                    @if (Model.IteracionesRealizadas.HasValue)
                    {
                        @Model.IteracionesRealizadas.Value
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>
            </div>

            <div class="fila-resultado">
                <label>Tolerancia utilizada</label>

                <div class="valor-resultado">

                    @if (Model.Tolerancia.HasValue)
                    {
                        @Model.Tolerancia.Value
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>
            </div>

            <div class="fila-resultado">
                <label>Valores iniciales</label>

                <div class="valor-resultado">

                    @if (Model.Metodo == "Biseccion" ||
                         Model.Metodo == "ReglaFalsa")
                    {
                        if (Model.Xi.HasValue &&
                            Model.Xd.HasValue)
                        {
                            <text>
                                [@Model.Xi.Value, @Model.Xd.Value]
                            </text>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    }
                    else if (Model.Metodo == "Newton")
                    {
                        if (Model.X0.HasValue)
                        {
                            <text>
                                X0 = @Model.X0.Value
                            </text>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    }
                    else if (Model.Metodo == "Secante")
                    {
                        if (Model.X0.HasValue &&
                            Model.X1.HasValue)
                        {
                            <text>
                                X0 = @Model.X0.Value,
                                X1 = @Model.X1.Value
                            </text>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>
            </div>

            <div class="fila-resultado">
                <label>¿Converge?</label>

                <div class="valor-resultado">

                    @if (Model.Converge.HasValue)
                    {
                        if (Model.Converge.Value)
                        {
                            <text>Sí</text>
                        }
                        else
                        {
                            <text>No</text>
                        }
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>
            </div>

            <div class="fila-resultado">
                <label>Raíz</label>

                <div class="valor-resultado">

                    @if (Model.Raiz.HasValue)
                    {
                        @Model.Raiz.Value
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>
            </div>

            <div class="fila-resultado">
                <label>Error</label>

                <div class="valor-resultado">

                    @if (Model.Error.HasValue)
                    {
                        @Model.Error.Value
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>
            </div>

        </section>

    </div>

</main>

<!-- GeoGebra -->
<script src="https://www.geogebra.org/apps/deployggb.js"></script>

<script>

    var parametros = {

        "appName": "classic",
        "perspective": "G",

        "width": 590,
        "height": 520,

        "showToolBar": false,
        "showAlgebraInput": false,
        "showMenuBar": false,
        "enableShiftDragZoom": true,

        "appletOnLoad": function (api) {

            var funcion =
                '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Funcion ?? ""))';

            var funcionValida =
                @((ViewBag.FuncionValida ?? false).ToString().ToLower());

            // Escala
            var xMin =
                @(Model.XMin.HasValue
                    ? Model.XMin.Value.ToString(
                        System.Globalization.CultureInfo.InvariantCulture)
                    : "-5");

            var xMax =
                @(Model.XMax.HasValue
                    ? Model.XMax.Value.ToString(
                        System.Globalization.CultureInfo.InvariantCulture)
                    : "5");

            api.setCoordSystem(
                xMin,
                xMax,
                -5,
                5
            );

            // Graficar función
            if (funcionValida && funcion !== "") {

                api.evalCommand(
                    "f(x)=" + funcion
                );
            }
        }
    };

    var applet =
        new GGBApplet(
            parametros,
            true
        );

    window.addEventListener(
        "load",
        function () {

            applet.inject(
                "ggb-element"
            );

        }
    );

</script>

<!-- Mostrar campos según método -->
<script>

    function actualizarCamposMetodo() {

        var metodo =
            document.getElementById("Metodo").value;

        var cerrados =
            document.getElementById("camposCerrados");

        var newton =
            document.getElementById("camposNewton");

        var secante =
            document.getElementById("camposSecante");

        cerrados.style.display = "none";
        newton.style.display = "none";
        secante.style.display = "none";

        if (
            metodo === "Biseccion" ||
            metodo === "ReglaFalsa"
        ) {
            cerrados.style.display = "block";
        }
        else if (
            metodo === "Newton"
        ) {
            newton.style.display = "block";
        }
        else if (
            metodo === "Secante"
        ) {
            secante.style.display = "block";
        }
    }

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            actualizarCamposMetodo();

            document
                .getElementById("Metodo")
                .addEventListener(
                    "change",
                    actualizarCamposMetodo
                );
        }
    );

</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}