@model AnalisisNumerico2026.Models.Unidad1ViewModel

@{
    ViewBag.Title = "Unidad 1 - Raíces de funciones";
}

<style>
    body {
        background-color: #FFFFFF;
    }

    .pagina-unidad {
        max-width: 1350px;
        margin: 30px auto;
        padding: 0 20px;
        font-family: Arial, sans-serif;
    }

    .volver {
        display: inline-block;
        margin-bottom: 18px;
        color: #666666;
        text-decoration: none;
        font-size: 14px;
        font-weight: bold;
    }

        .volver:hover {
            color: #E889AE;
            text-decoration: none;
        }

    .encabezado-unidad {
        margin: 0 0 28px 0;
        padding: 0;
        text-align: center;
    }

        .encabezado-unidad h1 {
            margin: 0 0 5px 0;
            padding: 0;
            color: #555555;
            font-size: 34px;
            font-weight: bold;
        }

        .encabezado-unidad p {
            margin: 0;
            padding: 0;
            color: #777777;
            font-size: 16px;
        }

    .linea-titulo {
        width: 60px;
        height: 3px;
        margin: 12px auto 0;
        border-radius: 3px;
        background-color: #E889AE;
    }

    /* Tres paneles al mismo nivel */
    .contenedor-paneles {
        display: grid;
        grid-template-columns: 270px 1fr 270px;
        gap: 20px;
        align-items: start;
        margin: 0;
        padding: 0;
    }

    .panel {
        margin: 0;
        padding: 18px;
        border: 2px solid #E8A0BC;
        border-radius: 6px;
        background-color: #FFFFFF;
        box-sizing: border-box;
        align-self: start;
    }

    .panel-ingreso {
        margin-top: 0;
        align-self: start;
    }

    .panel-grafico {
        margin-top: 0;
        padding: 25px;
        align-self: start;
    }

    .panel-resultados {
        margin-top: 0;
        align-self: start;
    }

    .panel h2 {
        margin: 0 0 18px 0;
        padding: 0;
        color: #555555;
        text-align: center;
        font-size: 20px;
        font-weight: bold;
        line-height: 1.2;
    }

    .panel-grafico h2 {
        margin: 0 0 25px 0;
        font-size: 22px;
    }

    .grupo-campo {
        margin-bottom: 12px;
    }

        .grupo-campo label {
            display: block;
            margin-bottom: 5px;
            color: #555555;
            font-size: 13px;
            font-weight: bold;
        }

    .campo {
        width: 100%;
        padding: 8px 9px;
        border: 1px solid #BBBBBB;
        border-radius: 2px;
        background-color: #FFFFFF;
        color: #444444;
        font-size: 14px;
        box-sizing: border-box;
    }

        .campo:focus {
            outline: none;
            border-color: #E889AE;
            box-shadow: 0 0 0 2px rgba(232, 137, 174, 0.15);
        }

    .dos-columnas {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .subtitulo-campo {
        margin-top: 15px;
        margin-bottom: 9px;
        color: #666666;
        font-size: 13px;
        font-weight: bold;
    }

    .boton-calcular {
        width: 100%;
        margin-top: 7px;
        padding: 10px;
        border: none;
        border-radius: 2px;
        background-color: #E889AE;
        color: #FFFFFF;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        text-transform: uppercase;
    }

        .boton-calcular:hover {
            background-color: #DC789F;
        }

    .mensaje-error {
        margin-bottom: 20px;
        padding: 12px 15px;
        border-left: 5px solid #E889AE;
        background-color: #FCE8F0;
        color: #555555;
    }

    .text-danger {
        display: block;
        margin-top: 4px;
        color: #C45E83;
        font-size: 12px;
    }

    /* Gráfico - no modificar tamaño */
    .contenedor-geogebra {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

    #ggb-element {
        width: 590px;
        height: 520px;
        margin: 0 auto;
        overflow: hidden;
        border: 1px solid #E8A0BC;
        border-radius: 3px;
        background-color: white;
    }

        #ggb-element > div {
            margin: 0 auto !important;
        }

    /* Resultados */
    .fila-resultado {
        margin-bottom: 9px;
    }

        .fila-resultado label {
            display: block;
            margin-bottom: 4px;
            color: #555555;
            font-size: 13px;
            font-weight: bold;
        }

    .valor-resultado {
        min-height: 32px;
        padding: 7px 9px;
        border-bottom: 1px solid #E8A0BC;
        background-color: #FFF8FB;
        color: #555555;
        font-size: 14px;
        box-sizing: border-box;
        word-break: break-word;
    }

    .resultado-raiz {
        font-weight: bold;
    }

    @@media (max-width: 1050px) {

        .contenedor-paneles {
            grid-template-columns: 1fr;
        }

        #ggb-element {
            width: 100%;
            max-width: 590px;
        }
    }
</style>

<main class="pagina-unidad">

    <a href="@Url.Action("Index", "Home")"
       class="volver">
        ← Volver al menú principal
    </a>

    <header class="encabezado-unidad">

        <h1>
            Análisis Numérico
        </h1>

        <p>
            Unidad 1 - Raíces de funciones
        </p>

        <div class="linea-titulo"></div>

    </header>

    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
    {
        <div class="mensaje-error">
            @Model.MensajeError
        </div>
    }

    <div class="contenedor-paneles">

        <!-- Ingreso de datos -->
        <section class="panel panel-ingreso">

            <h2>
                Ingreso de datos
            </h2>

            @using (Html.BeginForm("Index", "Unidad1", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                // Función
                <div class="grupo-campo">

                    @Html.LabelFor(m => m.Funcion)

                    @Html.TextBoxFor(
                        m => m.Funcion,
                        new
                        {
                            @class = "campo",
                            placeholder = "Ejemplo: x^2 - 2"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Funcion,
                        "",
                        new { @class = "text-danger" })

                </div>

                // Método
                <div class="grupo-campo">

                    @Html.LabelFor(m => m.Metodo)

                    @Html.DropDownListFor(
                        m => m.Metodo,
                        new List<SelectListItem>
                        {
                            new SelectListItem
                            {
                                Text = "Seleccione un método",
                                Value = ""
                            },

                            new SelectListItem
                            {
                                Text = "Bisección",
                                Value = "Biseccion"
                            },

                            new SelectListItem
                            {
                                Text = "Regla falsa",
                                Value = "ReglaFalsa"
                            },

                            new SelectListItem
                            {
                                Text = "Newton-Raphson",
                                Value = "Newton"
                            },

                            new SelectListItem
                            {
                                Text = "Secante",
                                Value = "Secante"
                            }
                        },
                        new
                        {
                            @class = "campo",
                            id = "Metodo"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Metodo,
                        "",
                        new { @class = "text-danger" })

                </div>

                // Iteraciones
                <div class="grupo-campo">

                    @Html.LabelFor(m => m.Iteraciones)

                    @Html.TextBoxFor(
                        m => m.Iteraciones,
                        new
                        {
                            @class = "campo",
                            type = "number",
                            min = "1",
                            placeholder = "Ejemplo: 100"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Iteraciones,
                        "",
                        new { @class = "text-danger" })

                </div>

                // Tolerancia
                <div class="grupo-campo">

                    @Html.LabelFor(m => m.Tolerancia)

                    @Html.TextBoxFor(
                        m => m.Tolerancia,
                        new
                        {
                            @class = "campo",
                            placeholder = "Ejemplo: 0.0001"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Tolerancia,
                        "",
                        new { @class = "text-danger" })

                </div>

                // Bisección y Regla Falsa
                <div id="camposCerrados"
                     style="display:none;">

                    <div class="subtitulo-campo">
                        Intervalo
                    </div>

                    <div class="dos-columnas">

                        <div class="grupo-campo">

                            @Html.LabelFor(m => m.Xi)

                            @Html.TextBoxFor(
                                m => m.Xi,
                                new
                                {
                                    @class = "campo",
                                    placeholder = "Xi"
                                })

                        </div>

                        <div class="grupo-campo">

                            @Html.LabelFor(m => m.Xd)

                            @Html.TextBoxFor(
                                m => m.Xd,
                                new
                                {
                                    @class = "campo",
                                    placeholder = "Xd"
                                })

                        </div>

                    </div>

                </div>

                // Newton y Secante
                <div id="camposAbiertos"
                     style="display:none;">

                    <div class="subtitulo-campo"
                         id="tituloValoresIniciales">

                        Valores iniciales

                    </div>

                    <div class="dos-columnas"
                         id="contenedorValoresAbiertos">

                        <div class="grupo-campo"
                             id="campoX0">

                            @Html.LabelFor(m => m.X0)

                            @Html.TextBoxFor(
                                m => m.X0,
                                new
                                {
                                    @class = "campo",
                                    placeholder = "X0"
                                })

                        </div>

                        <div class="grupo-campo"
                             id="campoX1">

                            @Html.LabelFor(m => m.X1)

                            @Html.TextBoxFor(
                                m => m.X1,
                                new
                                {
                                    @class = "campo",
                                    placeholder = "X1"
                                })

                        </div>

                    </div>

                </div>

                // Escala del gráfico
                <div class="subtitulo-campo">
                    Escala del gráfico
                </div>

                <div class="dos-columnas">

                    <div class="grupo-campo">

                        @Html.LabelFor(m => m.XMin)

                        @Html.TextBoxFor(
                            m => m.XMin,
                            new
                            {
                                @class = "campo",
                                placeholder = "-5"
                            })

                    </div>

                    <div class="grupo-campo">

                        @Html.LabelFor(m => m.XMax)

                        @Html.TextBoxFor(
                            m => m.XMax,
                            new
                            {
                                @class = "campo",
                                placeholder = "5"
                            })

                    </div>

                </div>

                <button type="submit"
                        class="boton-calcular">

                    Calcular

                </button>
            }

        </section>

        <!-- Gráfico -->
        <section class="panel panel-grafico">

            <h2>
                Gráfico
            </h2>

            <div class="contenedor-geogebra">

                <div id="ggb-element"></div>

            </div>

        </section>

        <!-- Resultados -->
        <section class="panel panel-resultados">

            <h2>
                Resultados
            </h2>

            <div class="fila-resultado">

                <label>
                    Función utilizada
                </label>

                <div class="valor-resultado">

                    @if (!string.IsNullOrWhiteSpace(Model.Funcion))
                    {
                        @Model.Funcion
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>

            </div>

            <div class="fila-resultado">

                <label>
                    Método utilizado
                </label>

                <div class="valor-resultado">

                    @if (Model.Metodo == "Biseccion")
                    {
                        <text>Bisección</text>
                    }
                    else if (Model.Metodo == "ReglaFalsa")
                    {
                        <text>Regla falsa</text>
                    }
                    else if (Model.Metodo == "Newton")
                    {
                        <text>Newton-Raphson</text>
                    }
                    else if (Model.Metodo == "Secante")
                    {
                        <text>Secante</text>
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>

            </div>

            <div class="fila-resultado">

                <label>
                    Iteraciones realizadas
                </label>

                <div class="valor-resultado">

                    @if (Model.IteracionesRealizadas.HasValue)
                    {
                        @Model.IteracionesRealizadas.Value
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>

            </div>

            <div class="fila-resultado">

                <label>
                    Tolerancia utilizada
                </label>

                <div class="valor-resultado">

                    @if (Model.Tolerancia.HasValue)
                    {
                        @Model.Tolerancia.Value
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>

            </div>

            <div class="fila-resultado">

                <label>
                    Valores iniciales
                </label>

                <div class="valor-resultado">

                    @if (Model.Metodo == "Biseccion" ||
                         Model.Metodo == "ReglaFalsa")
                    {
                        if (Model.Xi.HasValue &&
                            Model.Xd.HasValue)
                        {
                            <text>
                                Xi = @Model.Xi.Value,
                                Xd = @Model.Xd.Value
                            </text>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    }
                    else if (Model.Metodo == "Newton")
                    {
                        if (Model.X0.HasValue)
                        {
                            <text>
                                X0 = @Model.X0.Value
                            </text>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    }
                    else if (Model.Metodo == "Secante")
                    {
                        if (Model.X0.HasValue &&
                            Model.X1.HasValue)
                        {
                            <text>
                                X0 = @Model.X0.Value,
                                X1 = @Model.X1.Value
                            </text>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>

            </div>

            <div class="fila-resultado">

                <label>
                    ¿Converge?
                </label>

                <div class="valor-resultado">

                    @if (Model.Converge.HasValue)
                    {
                        if (Model.Converge.Value)
                        {
                            <text>Sí</text>
                        }
                        else
                        {
                            <text>No</text>
                        }
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>

            </div>

            <div class="fila-resultado">

                <label>
                    Raíz
                </label>

                <div class="valor-resultado resultado-raiz">

                    @if (Model.Raiz.HasValue)
                    {
                        @Model.Raiz.Value
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>

            </div>

            <div class="fila-resultado">

                <label>
                    Error
                </label>

                <div class="valor-resultado">

                    @if (Model.Error.HasValue)
                    {
                        @Model.Error.Value
                    }
                    else
                    {
                        <text>—</text>
                    }

                </div>

            </div>

        </section>

    </div>

</main>

<!-- GeoGebra -->
<script src="https://www.geogebra.org/apps/deployggb.js"></script>

<script>

    var parametros = {

        "appName": "classic",
        "perspective": "G",

        "width": 590,
        "height": 520,

        "showToolBar": false,
        "showAlgebraInput": false,
        "showMenuBar": false,
        "enableShiftDragZoom": true,

        "appletOnLoad": function (api) {

            var funcion =
                '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Funcion ?? ""))';

            var funcionValida =
                @((ViewBag.FuncionValida ?? false).ToString().ToLower());

            // Escala
            var xMin =
                @(Model.XMin.HasValue
                    ? Model.XMin.Value.ToString(
                        System.Globalization.CultureInfo.InvariantCulture)
                    : "-5");

            var xMax =
                @(Model.XMax.HasValue
                    ? Model.XMax.Value.ToString(
                        System.Globalization.CultureInfo.InvariantCulture)
                    : "5");

            // Raíz
            var tieneRaiz =
                @Model.Raiz.HasValue.ToString().ToLower();

            var raiz =
                @(Model.Raiz.HasValue
                    ? Model.Raiz.Value.ToString(
                        System.Globalization.CultureInfo.InvariantCulture)
                    : "0");

            api.setCoordSystem(
                xMin,
                xMax,
                -5,
                5
            );

            // Graficar función
            if (
                funcionValida &&
                funcion !== ""
            ) {

                api.evalCommand(
                    "f(x)=" + funcion
                );

                api.setColor(
                    "f",
                    232,
                    137,
                    174
                );

                api.setLineThickness(
                    "f",
                    4
                );
            }

            // Marcar raíz
            if (
                funcionValida &&
                tieneRaiz
            ) {

                api.evalCommand(
                    "R=(" + raiz + ",0)"
                );

                api.setColor(
                    "R",
                    232,
                    137,
                    174
                );

                api.setPointSize(
                    "R",
                    7
                );

                api.setLabelVisible(
                    "R",
                    true
                );
            }
        }
    };

    var applet =
        new GGBApplet(
            parametros,
            true
        );

    window.addEventListener(
        "load",
        function () {

            applet.inject(
                "ggb-element"
            );

        }
    );

</script>

<!-- Mostrar campos según método -->
<script>

    function actualizarCamposMetodo() {

        var metodo =
            document.getElementById("Metodo").value;

        var cerrados =
            document.getElementById("camposCerrados");

        var abiertos =
            document.getElementById("camposAbiertos");

        var campoX1 =
            document.getElementById("campoX1");

        var contenedorAbiertos =
            document.getElementById(
                "contenedorValoresAbiertos"
            );

        var titulo =
            document.getElementById(
                "tituloValoresIniciales"
            );

        cerrados.style.display =
            "none";

        abiertos.style.display =
            "none";

        campoX1.style.display =
            "none";

        // Bisección y Regla Falsa
        if (
            metodo === "Biseccion" ||
            metodo === "ReglaFalsa"
        ) {

            cerrados.style.display =
                "block";

        }

        // Newton-Raphson
        else if (
            metodo === "Newton"
        ) {

            abiertos.style.display =
                "block";

            campoX1.style.display =
                "none";

            titulo.innerText =
                "Valor inicial";

            contenedorAbiertos.style.gridTemplateColumns =
                "1fr";

        }

        // Secante
        else if (
            metodo === "Secante"
        ) {

            abiertos.style.display =
                "block";

            campoX1.style.display =
                "block";

            titulo.innerText =
                "Valores iniciales";

            contenedorAbiertos.style.gridTemplateColumns =
                "1fr 1fr";

        }
    }

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            actualizarCamposMetodo();

            document
                .getElementById("Metodo")
                .addEventListener(
                    "change",
                    actualizarCamposMetodo
                );

        }
    );

</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}